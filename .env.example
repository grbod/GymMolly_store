# Variable names only. Real values live in the server-owned /opt/gymmolly/.env
# (and in local untracked env files). Never commit values.
FLASK_ENV=
DATABASE_URL=
SS_CLIENT_ID=
SS_CLIENT_SECRET=
SS_STORE_ID=
SENDER_EMAIL=
RECIPIENT_EMAIL=
# Email provider: Cloudflare is used when both are set
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# Rollback only: used when the Cloudflare vars are unset
SENDGRID_API_KEY=
